# --- Network ---
NEAR_NETWORK=testnet                 # testnet | mainnet
BANK_ID=                             # e.g. heist-bank-6d6395.testnet. Empty = demo bank (simulated, no wallet)
NEAR_RPC_URL=                        # optional override
MAINNET_DISABLED=true                # kill switch: refuses every money route on mainnet while true
MAINNET_MAX_PAYOUT_NEAR=1            # guardian refuses to sign if the vault's cap is above this on mainnet

# --- Guardian ---
GUARDIAN_SECRET_B64=                 # default guardian seed (Teller + sponsored vaults), from `npm run keygen`. Never commit.
GUARDIAN_GOLD_SECRET_B64=            # Gold Vault guardian seed (its own key)
LLM_API_KEY=                         # NEAR AI Cloud key. Empty = scripted demo guardian
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_MODEL=                           # optional pin; default tries deepseek-v4.1-flash, glm-5.3-flash, Qwen3

# --- Durable store (required outside demo mode in production) ---
UPSTASH_REDIS_REST_URL=              # or KV_REST_API_URL (Vercel KV / Upstash)
UPSTASH_REDIS_REST_TOKEN=            # or KV_REST_API_TOKEN

# --- Spend limits ---
DAILY_AI_CALLS=400                   # paid vaults, all players combined
LOBBY_DAILY_AI_CALLS=300             # free Lobby, separate budget
LOBBY_MODEL=                         # optional cheaper model for the Lobby
ACCOUNT_DAILY_MESSAGES=40            # per wallet
IP_HOURLY_MESSAGES=40                # per IP
TURNS_PER_ATTEMPT=6

# --- Cross-chain cash-out (mainnet only) ---
ONECLICK_JWT=                        # optional; without it 1Click charges 0.2%
NEXT_PUBLIC_NEAR_NETWORK=testnet

# --- Judge (second model that scores each message and moves the resolve dial) ---
JUDGE=true                           # false = the guardian's own INTEGRITY estimate moves the dial
JUDGE_MODEL=                         # optional pin; defaults to LLM_MODEL or the guardian's fallbacks
